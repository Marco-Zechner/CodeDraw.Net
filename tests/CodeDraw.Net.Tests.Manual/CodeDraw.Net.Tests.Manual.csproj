<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Optional: helps copying assets from packages in some cases -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>CodeDraw.Net.Tests.Manual</AssemblyName>
    <RootNamespace>MarcoZechner.CodeDrawDotNet.Tests.Manual</RootNamespace>
    <PackageId>MarcoZechner.CodeDraw.Net.Tests.Manual</PackageId>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Silk.NET" Version="2.22.0" />
    <PackageReference Include="SpaceWizards.SharpFont" Version="1.1.0" />
    <PackageReference Include="SharpFont.Dependencies" Version="2.5.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeDraw.Net\CodeDraw.Net.csproj" />
  </ItemGroup>

  <!-- Ensure freetype6.dll ends up next to the EXE (this is the folder that matters at runtime). -->
  <Target Name="CopySharpFontNative" AfterTargets="Build">
    <PropertyGroup>
      <SharpFontDepsRoot>$(NuGetPackageRoot)sharpfont.dependencies\2.5.5\bin</SharpFontDepsRoot>
    </PropertyGroup>

    <!-- Try a few common MSVC folders; keep it resilient -->
    <ItemGroup>
      <_SfCandidates Include="$(SharpFontDepsRoot)\msvc12\x64\freetype6.dll" Condition="Exists('$(SharpFontDepsRoot)\msvc12\x64\freetype6.dll')" />
      <_SfCandidates Include="$(SharpFontDepsRoot)\msvc14\x64\freetype6.dll" Condition="Exists('$(SharpFontDepsRoot)\msvc14\x64\freetype6.dll')" />
      <_SfCandidates Include="$(SharpFontDepsRoot)\msvc15\x64\freetype6.dll" Condition="Exists('$(SharpFontDepsRoot)\msvc15\x64\freetype6.dll')" />
      <_SfCandidates Include="$(SharpFontDepsRoot)\msvc16\x64\freetype6.dll" Condition="Exists('$(SharpFontDepsRoot)\msvc16\x64\freetype6.dll')" />
      <_SfCandidates Include="$(SharpFontDepsRoot)\msvc17\x64\freetype6.dll" Condition="Exists('$(SharpFontDepsRoot)\msvc17\x64\freetype6.dll')" />
    </ItemGroup>

    <Copy SourceFiles="@(_SfCandidates)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_SfCandidates)' != ''" />

    <!-- Make it loud if nothing was found -->
    <Error Condition="'@(_SfCandidates)' == ''"
           Text="SharpFont.Dependencies freetype6.dll not found under '$(SharpFontDepsRoot)'. Check package contents / version." />
  </Target>

</Project>
