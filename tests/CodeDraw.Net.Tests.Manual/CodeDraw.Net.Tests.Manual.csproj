<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>CodeDraw.Net.Tests.Manual</AssemblyName>
    <RootNamespace>MarcoZechner.CodeDrawDotNet.Tests.Manual</RootNamespace>
    <PackageId>MarcoZechner.CodeDraw.Net.Tests.Manual</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET" Version="2.22.0" />
<!--    <PackageReference Include="SkiaSharp" Version="3.116.1" />-->
<!--    <PackageReference Include="Topten.RichTextKit" Version="0.4.167" />-->
<!--    <PackageReference Include="StbImageSharp" Version="2.30.15" />-->
    <PackageReference Include="SpaceWizards.SharpFont" Version="1.1.0" />
    <PackageReference Include="SharpFont.Dependencies" Version="2.5.5" />
  </ItemGroup>

  <Target Name="CopySharpFontNative" AfterTargets="Build">
    <!-- pick one msvc folder that exists; msvc12 is usually fine -->
    <PropertyGroup>
      <SharpFontDepsDir>$(NuGetPackageRoot)sharpfont.dependencies\2.5.5\bin\msvc12</SharpFontDepsDir>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(SharpFontDepsDir)\x64\freetype6.dll')">
      <SharpFontNative Include="$(SharpFontDepsDir)\x64\freetype6.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(SharpFontNative)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="@(SharpFontNative) != ''" />
  </Target>
  
  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeDraw.Net\CodeDraw.Net.csproj" />
  </ItemGroup>

<!--    <ItemGroup Condition="'$(Configuration)'=='Debug' Or '$(Configuration)'=='Release'">-->
<!--        <Content Include="resources\**\*.*">-->
<!--            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>-->
<!--        </Content>-->
<!--    </ItemGroup>-->

</Project>
